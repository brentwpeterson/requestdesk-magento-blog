<script>
    function testConnection() {
        var btn = document.getElementById('requestdesk-test-btn');
        var resultDiv = document.getElementById('import-result');

        btn.disabled = true;
        btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Testing...')) ?>';

        fetch('<?= $escaper->escapeUrl($block->getTestUrl()) ?>', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            resultDiv.style.display = 'block';
            if (data.success) {
                resultDiv.className = 'message message-success';
                var msg = '<strong><?= $escaper->escapeJs(__('Connection Successful!')) ?></strong>';
                if (data.agent_name) {
                    msg += '<br><?= $escaper->escapeJs(__('Agent:')) ?> ' + data.agent_name;
                }
                if (data.posts_available !== undefined) {
                    msg += '<br><?= $escaper->escapeJs(__('Posts available:')) ?> ' + data.posts_available;
                }
                resultDiv.innerHTML = msg;
            } else {
                resultDiv.className = 'message message-error';
                resultDiv.innerHTML = '<strong><?= $escaper->escapeJs(__('Connection Failed')) ?></strong><br>' +
                    (data.error || '<?= $escaper->escapeJs(__('Unknown error')) ?>');
            }
        })
        .catch(error => {
            resultDiv.style.display = 'block';
            resultDiv.className = 'message message-error';
            resultDiv.innerHTML = '<strong><?= $escaper->escapeJs(__('Request Failed')) ?></strong><br>' + error.message;
        })
        .finally(() => {
            btn.disabled = false;
            btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Test Connection')) ?>';
        });
    }

    function importPosts() {
        var btn = document.getElementById('requestdesk-import-btn');
        var resultDiv = document.getElementById('import-result');
        var statusFilter = document.getElementById('import-status-filter').value;
        var syncFilter = document.getElementById('import-sync-filter').value;

        if (!confirm('<?= $escaper->escapeJs(__('This will import posts from RequestDesk. Existing posts will be updated. Continue?')) ?>')) {
            return;
        }

        btn.disabled = true;
        btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Importing...')) ?>';
        resultDiv.style.display = 'block';
        resultDiv.className = 'message message-info';
        resultDiv.innerHTML = '<?= $escaper->escapeJs(__('Importing posts... This may take a moment.')) ?>';

        var url = '<?= $escaper->escapeUrl($block->getImportUrl()) ?>';
        var params = new URLSearchParams();
        if (statusFilter) params.append('status', statusFilter);
        if (syncFilter) params.append('sync_status', syncFilter);
        if (params.toString()) url += '?' + params.toString();

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                resultDiv.className = 'message message-success';
                var msg = '<strong><?= $escaper->escapeJs(__('Import Complete!')) ?></strong><br>';
                msg += '<?= $escaper->escapeJs(__('Created:')) ?> ' + (data.imported || 0) + '<br>';
                msg += '<?= $escaper->escapeJs(__('Updated:')) ?> ' + (data.updated || 0) + '<br>';
                if (data.failed > 0) {
                    msg += '<?= $escaper->escapeJs(__('Failed:')) ?> ' + data.failed;
                }
                if (data.has_more) {
                    msg += '<br><em><?= $escaper->escapeJs(__('More posts available - run import again to continue.')) ?></em>';
                }
                resultDiv.innerHTML = msg;

                // Reload page after 2 seconds to update counts
                setTimeout(function() {
                    location.reload();
                }, 2000);
            } else {
                resultDiv.className = 'message message-error';
                resultDiv.innerHTML = '<strong><?= $escaper->escapeJs(__('Import Failed')) ?></strong><br>' +
                    (data.error || '<?= $escaper->escapeJs(__('Unknown error')) ?>');
            }
        })
        .catch(error => {
            resultDiv.className = 'message message-error';
            resultDiv.innerHTML = '<strong><?= $escaper->escapeJs(__('Request Failed')) ?></strong><br>' + error.message;
        })
        .finally(() => {
            btn.disabled = false;
            btn.querySelector('span').textContent = '<?= $escaper->escapeJs(__('Import Posts')) ?>';
        });
    }
</script>


<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">requestdesk_blog_post_form.requestdesk_blog_post_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Post Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="RequestDesk\Blog\Block\Adminhtml\Post\Edit\BackButton"/>
            <button name="delete" class="RequestDesk\Blog\Block\Adminhtml\Post\Edit\DeleteButton"/>
            <button name="save" class="RequestDesk\Blog\Block\Adminhtml\Post\Edit\SaveButton"/>
            <button name="save_and_continue" class="RequestDesk\Blog\Block\Adminhtml\Post\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>requestdesk_blog_post_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>requestdesk_blog_post_form.requestdesk_blog_post_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="requestdesk_blog_post_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="requestdesk_blog/post/save"/>
        </settings>
        <dataProvider class="RequestDesk\Blog\Model\Post\DataProvider"
                      name="requestdesk_blog_post_form_data_source">
            <settings>
                <requestFieldName>post_id</requestFieldName>
                <primaryFieldName>post_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>

        <field name="post_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>

        <field name="title" sortOrder="10" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Title</label>
            </settings>
        </field>

        <field name="url_key" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
            </settings>
        </field>

        <!-- Single source of truth for the byline. The old free-text "author"
             column is still read as a fallback for posts imported before authors
             became records, but it is no longer editable here: having both a
             free-text name and a picker on one form meant two fields that
             silently overrode each other. -->
        <field name="author_id" sortOrder="30" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Author</label>
                <notice translate="true">Manage the list under Content &gt; RequestDesk Blog &gt; Authors.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Source\BlogAuthors"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="is_active" sortOrder="40" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>

        <!-- Defaults to 1 to match the column default, so a new post behaves the
             way every post did before this toggle existed. -->
        <field name="comments_enabled" sortOrder="50" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Allow Comment</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="associations">
        <settings>
            <label translate="true">Categories, Tags &amp; Q&amp;A</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>

        <field name="category_ids" sortOrder="20" formElement="multiselect">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Categories</label>
                <notice translate="true">Native Magento categories.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Source\Categories"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>

        <field name="tag_ids" sortOrder="30" formElement="multiselect">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Tags</label>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Source\Tags"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>

        <field name="qa_ids" sortOrder="40" formElement="multiselect">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Q&amp;A Pairs (FAQ)</label>
                <notice translate="true">Reusable shared Q&amp;A pairs. Drive the on-page FAQ and FAQPage schema.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Source\QaPairs"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="content">
        <settings>
            <label translate="true">Content</label>
            <collapsible>true</collapsible>
        </settings>

        <!-- formElement="wysiwyg" alone binds this field to Magento's editor, and
             wysiwygConfigData below configures it. There is no <wysiwyg> element in
             ui_definition.xsd; one used to sit in <settings> here and failed XML
             validation ("Element 'wysiwyg': This element is not expected"), which
             took the whole form down.

             Do NOT add a class="..." here either: core's own cms_page_form.xml
             declares no class, and Page Builder attaches itself through a di
             preference on Magento\Ui\Component\Form\Element\Wysiwyg. Naming a class
             explicitly bypasses that preference, and the class this once pointed at
             (Magento\Cms\Ui\Component\Form\Element\Wysiwyg) does not exist in 2.4.7
             at all, which fataled the form a different way. -->
        <field name="content" sortOrder="10" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="height" xsi:type="string">400px</item>
                        <item name="add_variables" xsi:type="boolean">false</item>
                        <item name="add_widgets" xsi:type="boolean">false</item>
                        <item name="add_images" xsi:type="boolean">true</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Content</label>
            </settings>
        </field>
    </fieldset>

    <fieldset name="seo">
        <settings>
            <label translate="true">SEO</label>
            <collapsible>true</collapsible>
        </settings>

        <field name="meta_title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
            </settings>
        </field>

        <field name="meta_description" sortOrder="20" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
            </settings>
        </field>
    </fieldset>

    <fieldset name="sync_info">
        <settings>
            <label translate="true">RequestDesk Sync</label>
            <collapsible>true</collapsible>
        </settings>

        <field name="requestdesk_post_id" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">RequestDesk ID</label>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="requestdesk_sync_status" sortOrder="20" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Sync Status</label>
                <disabled>true</disabled>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Post\Source\SyncStatus"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="requestdesk_last_sync" sortOrder="30" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Last Synced</label>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
</form>

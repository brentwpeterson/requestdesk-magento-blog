<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * RequestDesk Blog Author Profile Form UI Component
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">requestdesk_blog_author_form.requestdesk_blog_author_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Author</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\BackButton"/>
            <button name="delete" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\DeleteButton"/>
            <button name="save" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\SaveButton"/>
            <button name="save_and_continue" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>requestdesk_blog_author_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>requestdesk_blog_author_form.requestdesk_blog_author_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="requestdesk_blog_author_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="requestdesk_blog/author/save"/>
        </settings>
        <dataProvider class="RequestDesk\Blog\Model\Author\DataProvider"
                      name="requestdesk_blog_author_form_data_source">
            <settings>
                <requestFieldName>author_id</requestFieldName>
                <primaryFieldName>author_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>

        <field name="author_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>

        <field name="name" sortOrder="10" formElement="input">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <notice translate="true">The byline shown on posts. No Magento account required.</notice>
            </settings>
        </field>

        <field name="url_key" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <notice translate="true">Leave blank to generate one from the name.</notice>
            </settings>
        </field>

        <!-- Optional, and deliberately NOT required: an author may be a freelance
             or guest writer with no Magento login. -->
        <field name="admin_user_id" sortOrder="30" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Linked Admin User</label>
                <notice translate="true">Optional. Link this author to a Magento admin account, or leave as None.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Source\AdminUsers"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="bio" sortOrder="40" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Bio</label>
            </settings>
        </field>

        <field name="avatar" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Avatar</item>
                    <item name="formElement" xsi:type="string">imageUploader</item>
                    <item name="componentType" xsi:type="string">imageUploader</item>
                    <item name="dataScope" xsi:type="string">avatar</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="requestdesk_blog/author/upload"/>
                    </item>
                    <item name="previewTmpl" xsi:type="string">Magento_Catalog/image-preview</item>
                    <item name="allowedExtensions" xsi:type="string">jpg jpeg png gif webp</item>
                    <item name="maxFileSize" xsi:type="number">4194304</item>
                    <item name="notice" xsi:type="string" translate="true">Upload a square image. JPG, PNG, GIF or WebP, up to 4 MB.</item>
                </item>
            </argument>
        </field>

        <field name="url" sortOrder="60" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Link</label>
                <notice translate="true">Author's site or social profile URL.</notice>
            </settings>
        </field>
    </fieldset>
</form>

<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * RequestDesk Blog Author Profile Form UI Component
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">requestdesk_blog_author_form.requestdesk_blog_author_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Author Profile</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\BackButton"/>
            <button name="delete" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\DeleteButton"/>
            <button name="save" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\SaveButton"/>
            <button name="save_and_continue" class="RequestDesk\Blog\Block\Adminhtml\Author\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>requestdesk_blog_author_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>requestdesk_blog_author_form.requestdesk_blog_author_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="requestdesk_blog_author_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="requestdesk_blog/author/save"/>
        </settings>
        <dataProvider class="RequestDesk\Blog\Model\Author\DataProvider"
                      name="requestdesk_blog_author_form_data_source">
            <settings>
                <requestFieldName>admin_user_id</requestFieldName>
                <primaryFieldName>admin_user_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>

        <field name="admin_user_id" sortOrder="10" formElement="select">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Admin User</label>
                <notice translate="true">The native Magento admin account this public profile enriches.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="RequestDesk\Blog\Model\Source\AdminUsers"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="display_name" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Public Display Name</label>
                <notice translate="true">Overrides the admin account name in bylines. Leave blank to use the admin name.</notice>
            </settings>
        </field>

        <field name="bio" sortOrder="30" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Bio</label>
            </settings>
        </field>

        <field name="avatar" sortOrder="40" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Avatar Path</label>
                <notice translate="true">Media path or URL to the author's avatar image.</notice>
            </settings>
        </field>

        <field name="url" sortOrder="50" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Link</label>
                <notice translate="true">Author's site or social profile URL.</notice>
            </settings>
        </field>
    </fieldset>
</form>

<?xml version="1.0" encoding="UTF-8"?>
<!--
/**
 * RequestDesk Blog - Comments Moderation Grid
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">requestdesk_blog_comment_listing.requestdesk_blog_comment_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>requestdesk_blog_comment_columns</spinner>
        <deps>
            <dep>requestdesk_blog_comment_listing.requestdesk_blog_comment_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="requestdesk_blog_comment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">comment_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>RequestDesk_Blog::comments</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="requestdesk_blog_comment_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>comment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="approve">
                <settings>
                    <url path="requestdesk_blog/comment/massApprove"/>
                    <type>approve</type>
                    <label translate="true">Approve</label>
                </settings>
            </action>
            <action name="spam">
                <settings>
                    <confirm>
                        <message translate="true">Mark the selected comment(s) as spam?</message>
                        <title translate="true">Mark as Spam</title>
                    </confirm>
                    <url path="requestdesk_blog/comment/massSpam"/>
                    <type>spam</type>
                    <label translate="true">Mark as Spam</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected comment(s)? This cannot be undone.</message>
                        <title translate="true">Delete Comments</title>
                    </confirm>
                    <url path="requestdesk_blog/comment/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="requestdesk_blog_comment_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="comment_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>

        <column name="post_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Post ID</label>
            </settings>
        </column>

        <column name="author_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>

        <column name="author_email" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>

        <column name="content" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Comment</label>
            </settings>
        </column>

        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="RequestDesk\Blog\Model\Source\CommentStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Submitted</label>
            </settings>
        </column>
    </columns>
</listing>

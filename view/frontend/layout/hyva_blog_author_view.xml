<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Hyva Theme Layout for Author View
 *
 * Hyva loads a hyva_-prefixed handle IN ADDITION to the base one, not instead of
 * it. These handles used to declare a second block under a different name, so on
 * a Hyva store every blog page rendered twice - two grids, two h1s, the Luma
 * markup stacked above the Tailwind markup. It went unseen because the module
 * had no runnable Hyva install to look at.
 *
 * referenceBlock re-templates the block the base handle already defines. One
 * block, one render, and every argument and head addition on the base handle
 * still applies rather than needing a second copy here.
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The wrapper stays on the shared author/view.phtml: its inline styles
             are deliberate, so one profile header serves both themes. Only the
             posts child swaps to the Tailwind card grid. -->
        <referenceBlock name="requestdesk.blog.author.posts" template="RequestDesk_Blog::hyva/list.phtml"/>
    </body>
</page>

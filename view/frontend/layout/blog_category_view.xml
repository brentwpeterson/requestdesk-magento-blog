<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Category Filter Layout (default / Luma)
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The list template renders its own h1 (the category name); drop the
             theme's page-title block so the title does not appear twice. -->
        <referenceContainer name="page.main.title" remove="true"/>
        <referenceBlock name="page.title" remove="true"/>

        <referenceContainer name="content">
            <block class="RequestDesk\Blog\Block\CategoryView"
                   name="requestdesk.blog.category"
                   template="RequestDesk_Blog::list.phtml"/>
        </referenceContainer>
    </body>
</page>

<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Hyva Theme Layout for Tag View
 *
 * Renders the tag's posts with the same template the blog index uses, so a
 * tag archive looks exactly like the blog list page. The block class
 * (TagView) extends PostList and only swaps the collection.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!--
                cacheable="false" removed: it switched full page cache off for
                every blog listing on Hyva, while the matching Luma handle has
                never set it. A listing is public, identical for every visitor
                and the heaviest query in the module - exactly what FPC is for.
            -->
            <block class="RequestDesk\Blog\Block\TagView"
                   name="blog.tag.view"
                   template="RequestDesk_Blog::hyva/list.phtml"/>
        </referenceContainer>
    </body>
</page>

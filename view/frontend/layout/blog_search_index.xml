<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Search Results Layout (default / Luma)
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="2columns-right"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="requestdesk_blog_sidebar"/>
    <body>
        <!-- The list template renders its own h1; drop the theme's page-title
             block so the title does not appear twice. -->
        <referenceContainer name="page.main.title" remove="true"/>
        <referenceBlock name="page.title" remove="true"/>

        <referenceContainer name="content">
            <block class="RequestDesk\Blog\Block\SearchView"
                   name="requestdesk.blog.search"
                   template="RequestDesk_Blog::list.phtml">
                <block class="Magento\Framework\View\Element\Template"
                       name="requestdesk.blog.search.tabs"
                       as="listing_header"
                       template="RequestDesk_Blog::search/tabs.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>

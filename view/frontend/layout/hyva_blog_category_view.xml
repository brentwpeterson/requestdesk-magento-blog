<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Hyva Theme Layout for Category View
 *
 * Renders the category's posts with the same template the blog index uses,
 * so a category page looks exactly like the blog list page. The block class
 * (CategoryView) extends PostList and only swaps the collection.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="RequestDesk\Blog\Block\CategoryView"
                   name="blog.category.view"
                   template="RequestDesk_Blog::hyva/list.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>

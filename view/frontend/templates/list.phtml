<?php
/**
 * RequestDesk Blog - Post List Template (default / Luma)
 *
 * @var \RequestDesk\Blog\Block\PostList $block
 * @var \Magento\Framework\Escaper $escaper
 */

$posts = $block->getPosts();
?>
<div class="requestdesk-blog-list">
    <h1 class="page-title"><?= $escaper->escapeHtml(__('Blog')) ?></h1>

    <?php if (empty($posts)): ?>
        <p><?= $escaper->escapeHtml(__('No posts yet.')) ?></p>
    <?php else: ?>
        <ul class="rd-blog-grid" style="list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;">
            <?php foreach ($posts as $post): ?>
                <?php
                $url = $block->getPostUrl($post);
                $img = $block->getImageUrl($post->getFeaturedImage());
                ?>
                <li class="rd-blog-card" style="border:1px solid #e5e5e5;border-radius:6px;overflow:hidden;">
                    <?php if ($img !== ''): ?>
                        <a href="<?= $escaper->escapeUrl($url) ?>">
                            <img src="<?= $escaper->escapeUrl($img) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($post->getTitle()) ?>"
                                 style="width:100%;height:170px;object-fit:cover;display:block;" />
                        </a>
                    <?php endif; ?>
                    <div style="padding:16px;">
                        <h2 style="font-size:18px;margin:0 0 8px;">
                            <a href="<?= $escaper->escapeUrl($url) ?>"><?= $escaper->escapeHtml($post->getTitle()) ?></a>
                        </h2>
                        <p style="color:#777;font-size:13px;margin:0 0 8px;">
                            <?php $authorName = $block->getAuthorName($post); ?>
                            <?php if ($authorName !== ''): ?>
                                <?= $escaper->escapeHtml($authorName) ?> &middot;
                            <?php endif; ?>
                            <?= $escaper->escapeHtml($post->getCreatedAt()) ?>
                        </p>
                        <!--
                            Short Description when written, excerpt of the content
                            otherwise. Clamped to 4 lines to match the Hyva card.
                            Written inline because this template carries no
                            stylesheet of its own, and Luma has no line-clamp
                            utility to borrow the way Tailwind does.
                        -->
                        <div style="margin:0;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;">
                            <?= /* @noEscape */ $block->getCardSummaryHtml($post, 220) ?>
                        </div>
                    </div>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

    <?php /* Pagination lives outside the empty check: a past-the-end ?p= still has a
             real total count, so the visitor needs a way back to page 1 even though
             this page's own item list is empty. */ ?>
    <?php if ($block->hasPagination()): ?>
        <?php
        $currentPage = $block->getCurrentPage();
        $lastPage = $block->getLastPageNumber();
        // Sliding window around the current page, so the pager keeps a fixed
        // width whether the blog has 3 pages or 300.
        $windowStart = max(1, $currentPage - 2);
        $windowEnd = min($lastPage, $currentPage + 2);
        ?>
        <!--
            Luma's own pager classes (pages / pages-items / pages-item-*), so
            this picks up the theme's existing styling instead of shipping a
            second look for the same control.
        -->
        <div class="pages">
            <strong class="label pages-label" id="rd-blog-paging-label">
                <?= $escaper->escapeHtml(__('Page')) ?>
            </strong>
            <ul class="items pages-items" aria-labelledby="rd-blog-paging-label">
                <?php if ($currentPage > 1): ?>
                    <li class="item pages-item-previous">
                        <a class="action previous" rel="prev"
                           href="<?= $escaper->escapeUrl($block->getPageUrl($currentPage - 1)) ?>"
                           title="<?= $escaper->escapeHtmlAttr(__('Previous')) ?>">
                            <span class="label"><?= $escaper->escapeHtml(__('Page')) ?></span>
                            <span><?= $escaper->escapeHtml(__('Previous')) ?></span>
                        </a>
                    </li>
                <?php endif; ?>

                <?php if ($windowStart > 1): ?>
                    <li class="item">
                        <a class="page" href="<?= $escaper->escapeUrl($block->getPageUrl(1)) ?>">
                            <span class="label"><?= $escaper->escapeHtml(__('Page')) ?></span>
                            <span>1</span>
                        </a>
                    </li>
                    <?php if ($windowStart > 2): ?>
                        <li class="item">&hellip;</li>
                    <?php endif; ?>
                <?php endif; ?>

                <?php for ($page = $windowStart; $page <= $windowEnd; $page++): ?>
                    <?php if ($page === $currentPage): ?>
                        <li class="item current">
                            <strong class="page">
                                <span class="label">
                                    <?= $escaper->escapeHtml(__("You're currently reading page")) ?>
                                </span>
                                <span><?= $escaper->escapeHtml((string) $page) ?></span>
                            </strong>
                        </li>
                    <?php else: ?>
                        <li class="item">
                            <a class="page" href="<?= $escaper->escapeUrl($block->getPageUrl($page)) ?>">
                                <span class="label"><?= $escaper->escapeHtml(__('Page')) ?></span>
                                <span><?= $escaper->escapeHtml((string) $page) ?></span>
                            </a>
                        </li>
                    <?php endif; ?>
                <?php endfor; ?>

                <?php if ($windowEnd < $lastPage): ?>
                    <?php if ($windowEnd < $lastPage - 1): ?>
                        <li class="item">&hellip;</li>
                    <?php endif; ?>
                    <li class="item">
                        <a class="page" href="<?= $escaper->escapeUrl($block->getPageUrl($lastPage)) ?>">
                            <span class="label"><?= $escaper->escapeHtml(__('Page')) ?></span>
                            <span><?= $escaper->escapeHtml((string) $lastPage) ?></span>
                        </a>
                    </li>
                <?php endif; ?>

                <?php if ($currentPage < $lastPage): ?>
                    <li class="item pages-item-next">
                        <a class="action next" rel="next"
                           href="<?= $escaper->escapeUrl($block->getPageUrl($currentPage + 1)) ?>"
                           title="<?= $escaper->escapeHtmlAttr(__('Next')) ?>">
                            <span class="label"><?= $escaper->escapeHtml(__('Page')) ?></span>
                            <span><?= $escaper->escapeHtml(__('Next')) ?></span>
                        </a>
                    </li>
                <?php endif; ?>
            </ul>
        </div>
    <?php endif; ?>
</div>

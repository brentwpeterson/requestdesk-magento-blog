<?php
/**
 * RequestDesk Blog - Hyva Theme Blog Listing Template
 * Uses Tailwind CSS and Alpine.js
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use RequestDesk\Blog\Block\PostList;

/** @var Escaper $escaper */
/** @var PostList $block */

$posts = $block->getPosts();
/* CategoryView overrides this with the category name; the plain list says "Blog". */
$title = $block->getListingTitle();
?>

<div class="container mx-auto px-4 py-8">
    <?php /* Skipped when a wrapper block (author page) already renders the h1. */ ?>
    <?php if (!$block->getSuppressTitle()): ?>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
            <?= $escaper->escapeHtml($title !== '' ? $title : __('Blog')) ?>
        </h1>
    <?php endif; ?>

    <?php if (!empty($posts)): ?>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <?php foreach ($posts as $post): ?>
                <article class="card bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                    <?php $img = $block->getImageUrl($post->getFeaturedImage()); ?>
                    <?php if ($img !== ''): ?>
                        <a href="<?= $escaper->escapeUrl($block->getPostUrl($post)) ?>"
                           class="block aspect-video overflow-hidden">
                            <img src="<?= $escaper->escapeUrl($img) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($post->getTitle()) ?>"
                                 class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                 loading="lazy"/>
                        </a>
                    <?php endif; ?>

                    <div class="p-6">
                        <h2 class="text-xl font-semibold mb-3">
                            <a href="<?= $escaper->escapeUrl($block->getPostUrl($post)) ?>"
                               class="text-gray-900 hover:text-primary transition-colors duration-200">
                                <?= $escaper->escapeHtml($post->getTitle()) ?>
                            </a>
                        </h2>

                        <?php
                        /* getAuthorName() resolves the author entity the post view and
                           the Luma card both use. Reading $post->getAuthor() here meant
                           the flat varchar, so one post could show two different names
                           depending on the theme. */
                        $authorName = $block->getAuthorName($post);
                        $postDate = $block->getPostDate($post);
                        $categories = $block->getPostCategories($post);
                        ?>
                        <div class="flex flex-wrap items-center text-sm text-gray-500 mb-4 gap-4">
                            <?php if ($authorName !== ''): ?>
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    <?= $escaper->escapeHtml($authorName) ?>
                                </span>
                            <?php endif; ?>
                            <?php if ($postDate !== ''): ?>
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <?= $escaper->escapeHtml($postDate) ?>
                                </span>
                            <?php endif; ?>
                        </div>

                        <?php if ($categories !== []): ?>
                            <div class="flex flex-wrap gap-2 mb-4">
                                <?php foreach ($categories as $category): ?>
                                    <a href="<?= $escaper->escapeUrl($category['url']) ?>"
                                       class="inline-block text-xs bg-gray-100 text-gray-700 rounded px-2 py-1 hover:bg-gray-200">
                                        <?= $escaper->escapeHtml($category['name']) ?>
                                    </a>
                                <?php endforeach; ?>
                            </div>
                        <?php endif; ?>

                        <!-- Emitted as markup, not escaped text, so that hiding an
                             element in the editor takes effect here the same way it
                             does on the post. A div rather than a p: the short
                             description can contain block elements, and a <p> nested
                             in a <p> is auto-closed by the browser, which would break
                             both the clamp and the card. -->
                        <div class="text-gray-600 mb-4 line-clamp-4">
                            <?= /* @noEscape */ $block->getCardSummaryHtml($post, 220) ?>
                        </div>

                        <a href="<?= $escaper->escapeUrl($block->getPostUrl($post)) ?>"
                           class="inline-flex items-center text-primary font-medium hover:underline">
                            <?= $escaper->escapeHtml(__('Read More')) ?>
                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <div class="bg-gray-50 rounded-lg p-8 text-center">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
            <p class="text-gray-500 text-lg">
                <?= $escaper->escapeHtml(__('No blog posts available.')) ?>
            </p>
        </div>
    <?php endif; ?>

    <?php /* Pagination lives outside the empty check: a past-the-end ?p= still has a
             real total count, so the visitor needs a way back to page 1 even though
             this page's own item list is empty. */ ?>
    <?php if ($block->hasPagination()): ?>
        <?php
        $currentPage = $block->getCurrentPage();
        $lastPage = $block->getLastPageNumber();
        // Sliding window around the current page, so the pager keeps a fixed
        // width whether the blog has 3 pages or 300.
        $windowStart = max(1, $currentPage - 2);
        $windowEnd = min($lastPage, $currentPage + 2);
        $linkClass = 'px-3 py-2 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-100 '
            . 'transition-colors duration-200';
        ?>
        <nav class="flex justify-center mt-10"
             aria-label="<?= $escaper->escapeHtmlAttr(__('Blog pagination')) ?>">
            <ul class="inline-flex flex-wrap items-center gap-1">
                <?php if ($currentPage > 1): ?>
                    <li>
                        <a href="<?= $escaper->escapeUrl($block->getPageUrl($currentPage - 1)) ?>"
                           rel="prev" class="<?= $escaper->escapeHtmlAttr($linkClass) ?>">
                            <?= $escaper->escapeHtml(__('Previous')) ?>
                        </a>
                    </li>
                <?php endif; ?>

                <?php if ($windowStart > 1): ?>
                    <li>
                        <a href="<?= $escaper->escapeUrl($block->getPageUrl(1)) ?>"
                           class="<?= $escaper->escapeHtmlAttr($linkClass) ?>">1</a>
                    </li>
                    <?php if ($windowStart > 2): ?>
                        <li><span class="px-2 text-gray-400">&hellip;</span></li>
                    <?php endif; ?>
                <?php endif; ?>

                <?php for ($page = $windowStart; $page <= $windowEnd; $page++): ?>
                    <li>
                        <?php if ($page === $currentPage): ?>
                            <span aria-current="page"
                                  class="px-3 py-2 rounded-md bg-primary text-white font-semibold">
                                <?= $escaper->escapeHtml((string) $page) ?>
                            </span>
                        <?php else: ?>
                            <a href="<?= $escaper->escapeUrl($block->getPageUrl($page)) ?>"
                               class="<?= $escaper->escapeHtmlAttr($linkClass) ?>">
                                <?= $escaper->escapeHtml((string) $page) ?>
                            </a>
                        <?php endif; ?>
                    </li>
                <?php endfor; ?>

                <?php if ($windowEnd < $lastPage): ?>
                    <?php if ($windowEnd < $lastPage - 1): ?>
                        <li><span class="px-2 text-gray-400">&hellip;</span></li>
                    <?php endif; ?>
                    <li>
                        <a href="<?= $escaper->escapeUrl($block->getPageUrl($lastPage)) ?>"
                           class="<?= $escaper->escapeHtmlAttr($linkClass) ?>">
                            <?= $escaper->escapeHtml((string) $lastPage) ?>
                        </a>
                    </li>
                <?php endif; ?>

                <?php if ($currentPage < $lastPage): ?>
                    <li>
                        <a href="<?= $escaper->escapeUrl($block->getPageUrl($currentPage + 1)) ?>"
                           rel="next" class="<?= $escaper->escapeHtmlAttr($linkClass) ?>">
                            <?= $escaper->escapeHtml(__('Next')) ?>
                        </a>
                    </li>
                <?php endif; ?>
            </ul>
        </nav>
    <?php endif; ?>
</div>

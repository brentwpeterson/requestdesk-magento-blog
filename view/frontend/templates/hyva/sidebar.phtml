        <?php /* Live search like Amasty's: suggestions after the minimum characters,
                 without leaving the page; Enter or the button opens the full results. */ ?>
        <form action="<?= $escaper->escapeUrl($block->getSearchUrl()) ?>" method="get" role="search"
              class="relative" x-data="rdBlogSearch" @click.outside="close" @keydown.escape="close">
            <div class="flex">
                <label for="rd-blog-search-input" class="sr-only"><?= $escaper->escapeHtml(__('Search the blog')) ?></label>
                <input type="search" id="rd-blog-search-input"
                       name="<?= $escaper->escapeHtmlAttr($block->getSearchParamName()) ?>"
                       value="<?= $escaper->escapeHtmlAttr($block->getSearchQuery()) ?>"
                       maxlength="<?= (int) $block->getSearchMaxLength() ?>"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('Search posts')) ?>"

                <p x-show="message" x-text="message" class="px-4 py-3 text-sm text-gray-600"></p>
                <template x-for="group in groups" :key="group.type">
                    <div class="border-t border-gray-200 first:border-t-0">
                        <p class="px-4 pt-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500" x-text="group.label"></p>
                        <ul class="pb-2">
                            <template x-for="item in group.items" :key="item.url">
                                <li>
                                    <a :href="item.url" x-text="item.title"
                                       class="block px-4 py-2 text-sm text-gray-900 hover:bg-gray-100 hover:text-primary"></a>
                                </li>
                            </template>
                        </ul>
                    </div>
                </template>
            </div>
        </form>
        <script>
            function rdBlogSearch() {
                return {
                    groups: [],
                    message: '',
                    loading: false,
                    open: false,
                    controller: null,
                    get isOpen() {
                        return this.open && (this.groups.length > 0 || this.message !== '');
                    },
                    get isIdle() {
                        return !this.loading;
                    },
                    close() {
                        this.open = false;
                    },
                    reopen() {
                        this.open = true;
                    },
                    onInput(event) {
                        const input = event.target;
                        const query = input.value.trim();
                        if (this.controller) {
                            this.controller.abort();
                        }
                        if (query.length < parseInt(input.dataset.minChars, 10)) {
                            this.groups = [];
                            this.message = '';
                            this.loading = false;
                            return;
                        }
                        this.controller = new AbortController();
                        this.loading = true;
                        fetch(input.dataset.suggestUrl + '?query=' + encodeURIComponent(query), {
                            headers: {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'},
                            signal: this.controller.signal
                        })
                            .then(response => response.json())
                            .then(result => {
                                this.groups = result.groups || [];
                                this.message = result.message || '';
                                this.open = true;
                                this.loading = false;
                            })
                            .catch(error => {
                                // An aborted request was replaced by a newer one,
                                // which owns the spinner now.
                                if (error.name !== 'AbortError') {
                                    this.loading = false;
                                }
                            });
                    }
                };
            }
            window.addEventListener('alpine:init', () => Alpine.data('rdBlogSearch', rdBlogSearch), {once: true});
        </script>
        <?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
    </section>


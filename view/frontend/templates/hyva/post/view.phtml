<?php
/**
 * RequestDesk Blog - Hyva Theme Post View Template
 * Uses Tailwind CSS and Alpine.js
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use RequestDesk\Blog\Block\PostView;

/** @var Escaper $escaper */
/** @var PostView $block */

$post = $block->getPost();
?>

<?php if ($post && $post->getId()): ?>
<article class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Back Link -->
    <a href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"
       class="inline-flex items-center text-gray-600 hover:text-primary mb-6 transition-colors duration-200">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <?= $escaper->escapeHtml(__('Back to Blog')) ?>
    </a>

    <!-- Post Header -->
    <header class="mb-8">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 leading-tight">
            <?= $escaper->escapeHtml($post->getTitle()) ?>
        </h1>

        <div class="flex flex-wrap items-center text-sm text-gray-500 gap-4">
            <?php if ($post->getAuthor()): ?>
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <?= $escaper->escapeHtml($post->getAuthor()) ?>
                </span>
            <?php endif; ?>
            <span class="flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <?= $escaper->escapeHtml($post->getCreatedAt()) ?>
            </span>
        </div>
    </header>

    <!-- Featured Image -->
    <?php if ($post->getFeaturedImage()): ?>
        <figure class="mb-8 rounded-lg overflow-hidden shadow-lg">
            <img src="<?= $escaper->escapeUrl($post->getFeaturedImage()) ?>"
                 alt="<?= $escaper->escapeHtmlAttr($post->getTitle()) ?>"
                 class="w-full h-auto"
                 loading="eager"/>
        </figure>
    <?php endif; ?>

    <!-- Post Content -->
    <div class="prose prose-lg max-w-none
                prose-headings:font-bold prose-headings:text-gray-900
                prose-p:text-gray-700 prose-p:leading-relaxed
                prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                prose-img:rounded-lg prose-img:shadow-md
                prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-gray-50 prose-blockquote:py-2 prose-blockquote:px-4
                prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
                prose-pre:bg-gray-900 prose-pre:text-gray-100">
        <?= /* @noEscape */ $block->getRenderedContent() ?>
    </div>

    <!--
        Comments. Same block API and same POST contract as the Luma template
        (view/frontend/templates/post/view.phtml) - Controller\Comment\Save reads
        post_id, author_name, author_email, content, and the "website" honeypot,
        then redirects back here with a message. Only the markup differs.

        Alpine here does nothing the form needs to work: it guards against a
        double submit and shows a character count. With JS off, this is still a
        plain HTML form that posts and succeeds.
    -->
    <?php if ($post->getCommentsEnabled()): ?>
    <?php $comments = $block->getComments(); ?>
    <section class="mt-12 pt-8 border-t border-gray-200" id="comments">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
            <?= $escaper->escapeHtml(__('Comments')) ?>
            <?php if (!empty($comments)): ?>
                <span class="text-gray-400 font-normal">(<?= count($comments) ?>)</span>
            <?php endif; ?>
        </h2>

        <?php if (empty($comments)): ?>
            <p class="text-gray-500 mb-8"><?= $escaper->escapeHtml(__('No comments yet. Be the first.')) ?></p>
        <?php else: ?>
            <ul class="space-y-6 mb-10">
                <?php foreach ($comments as $comment): ?>
                    <li class="bg-gray-50 rounded-lg p-4">
                        <p class="font-semibold text-gray-900 mb-1">
                            <?= $escaper->escapeHtml($comment->getAuthorName()) ?>
                        </p>
                        <p class="text-gray-700 leading-relaxed">
                            <?= /* @noEscape */ nl2br($escaper->escapeHtml($comment->getContent())) ?>
                        </p>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>

        <h3 class="text-xl font-bold text-gray-900 mb-4">
            <?= $escaper->escapeHtml(__('Leave a Comment')) ?>
        </h3>

        <form action="<?= $escaper->escapeUrl($block->getCommentActionUrl()) ?>"
              method="post"
              class="max-w-xl"
              x-data="{ sending: false, body: '' }"
              @submit="sending = true">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
            <input type="hidden" name="post_id" value="<?= (int) $post->getPostId() ?>"/>

            <!-- Honeypot: off-screen rather than hidden, so bots that skip
                 display:none fields still fill it in. Any value rejects. -->
            <div style="position:absolute;left:-9999px;" aria-hidden="true">
                <label><?= $escaper->escapeHtml(__('Website')) ?>
                    <input type="text" name="website" tabindex="-1" autocomplete="off"/>
                </label>
            </div>

            <div class="mb-4">
                <label for="rd-comment-name" class="block text-sm font-medium text-gray-700 mb-1">
                    <?= $escaper->escapeHtml(__('Your name')) ?>
                </label>
                <input type="text" id="rd-comment-name" name="author_name" required
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-primary focus:ring-1 focus:ring-primary"/>
            </div>

            <div class="mb-4">
                <label for="rd-comment-email" class="block text-sm font-medium text-gray-700 mb-1">
                    <?= $escaper->escapeHtml(__('Your email (optional)')) ?>
                </label>
                <input type="email" id="rd-comment-email" name="author_email"
                       class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-primary focus:ring-1 focus:ring-primary"/>
            </div>

            <div class="mb-4">
                <label for="rd-comment-body" class="block text-sm font-medium text-gray-700 mb-1">
                    <?= $escaper->escapeHtml(__('Your comment')) ?>
                </label>
                <textarea id="rd-comment-body" name="content" rows="4" required x-model="body"
                          class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-primary focus:ring-1 focus:ring-primary"></textarea>
                <p class="text-xs text-gray-400 mt-1" x-show="body.length > 0" x-cloak>
                    <span x-text="body.length"></span> <?= $escaper->escapeHtml(__('characters')) ?>
                </p>
            </div>

            <button type="submit"
                    :disabled="sending"
                    class="inline-flex items-center px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-darker transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                <span x-show="!sending"><?= $escaper->escapeHtml(__('Post Comment')) ?></span>
                <span x-show="sending" x-cloak><?= $escaper->escapeHtml(__('Sending...')) ?></span>
            </button>

            <p class="text-xs text-gray-500 mt-3">
                <?= $escaper->escapeHtml(__('Comments are reviewed before they appear.')) ?>
            </p>
        </form>
    </section>
    <?php endif; ?>

    <!-- Post Footer -->
    <footer class="mt-12 pt-8 border-t border-gray-200">
        <a href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"
           class="inline-flex items-center px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-darker transition-colors duration-200">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            <?= $escaper->escapeHtml(__('Back to Blog')) ?>
        </a>
    </footer>
</article>
<?php else: ?>
<div class="container mx-auto px-4 py-16 text-center">
    <svg class="w-20 h-20 mx-auto text-gray-400 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
        <?= $escaper->escapeHtml(__('Post Not Found')) ?>
    </h1>
    <p class="text-gray-500 mb-6">
        <?= $escaper->escapeHtml(__('The blog post you are looking for does not exist.')) ?>
    </p>
    <a href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"
       class="inline-flex items-center px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-darker transition-colors duration-200">
        <?= $escaper->escapeHtml(__('Back to Blog')) ?>
    </a>
</div>
<?php endif; ?>

<?php
/**
 * RequestDesk Blog - canonical link tag
 *
 * @var \RequestDesk\Blog\Block\Head\Canonical $block
 * @var \Magento\Framework\Escaper $escaper
 */

$canonical = $block->getCanonicalUrl();
?>
<?php if ($canonical !== ''): ?>
<link rel="canonical" href="<?= $escaper->escapeUrl($canonical) ?>" />
<?php endif; ?>

<?php
/**
 * RequestDesk Blog - Category Filter Template (default / Luma)
 *
 * @var \RequestDesk\Blog\Block\CategoryView $block
 * @var \Magento\Framework\Escaper $escaper
 */

$name = $block->getCategoryName();
$posts = $block->getPosts();
?>
<div class="requestdesk-blog-category" style="max-width:820px;margin:0 auto;">
    <h1 class="page-title"><?= $escaper->escapeHtml(__('Blog: %1', $name)) ?></h1>

    <?php if (empty($posts)): ?>
        <p><?= $escaper->escapeHtml(__('No posts in this category yet.')) ?></p>
    <?php else: ?>
        <ul>
            <?php foreach ($posts as $post): ?>
                <li style="margin-bottom:8px;">
                    <a href="<?= $escaper->escapeUrl($block->getPostUrl($post)) ?>"><?= $escaper->escapeHtml($post->getTitle()) ?></a>
                    <span style="color:#777;font-size:13px;"> &middot; <?= $escaper->escapeHtml($post->getCreatedAt()) ?></span>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</div>

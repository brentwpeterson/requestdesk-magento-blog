<?php
/**
 * RequestDesk Blog - Author Page Template (theme-agnostic wrapper)
 *
 * Renders the author profile header, then delegates the post list to the
 * "posts" child block (added in blog_author_view.xml / hyva_blog_author_view.xml),
 * which uses the same shared list template as the blog index and category
 * pages. Inline styles on purpose: this wrapper renders on Luma and Hyva
 * alike, and neither ships a shared profile-header component to borrow.
 *
 * @var \RequestDesk\Blog\Block\AuthorView $block
 * @var \Magento\Framework\Escaper $escaper
 */

$author = $block->getAuthor();
?>
<?php if ($author): ?>
    <div class="requestdesk-blog-author" style="margin-bottom:24px;">
        <header style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
            <?php if ($author['avatar'] !== ''): ?>
                <img src="<?= $escaper->escapeUrl($author['avatar']) ?>"
                     alt="<?= $escaper->escapeHtmlAttr($author['name']) ?>"
                     style="width:72px;height:72px;border-radius:50%;object-fit:cover;" />
            <?php endif; ?>
            <div>
                <h1 class="page-title" style="margin:0;"><?= $escaper->escapeHtml($author['name']) ?></h1>
                <?php if ($author['link'] !== ''): ?>
                    <a href="<?= $escaper->escapeUrl($author['link']) ?>" rel="nofollow"><?= $escaper->escapeHtml($author['link']) ?></a>
                <?php endif; ?>
            </div>
        </header>

        <?php if ($author['bio'] !== ''): ?>
            <p style="margin:16px 0 0;"><?= $escaper->escapeHtml($author['bio']) ?></p>
        <?php endif; ?>
    </div>

    <?php /* The posts grid + optional pager; the child's own h1 is suppressed
           via the suppress_title layout argument so this page keeps exactly
           one h1. */ ?>
    <?= $block->getChildHtml('posts') ?>
<?php else: ?>
    <p><?= $escaper->escapeHtml(__('Author not found.')) ?></p>
<?php endif; ?>

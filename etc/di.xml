<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog Dependency Injection Configuration
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Interface Preferences -->
    <preference for="RequestDesk\Blog\Api\Data\PostInterface"
                type="RequestDesk\Blog\Model\Post"/>

    <preference for="RequestDesk\Blog\Api\Data\PostSearchResultsInterface"
                type="RequestDesk\Blog\Model\PostSearchResults"/>

    <preference for="RequestDesk\Blog\Api\PostRepositoryInterface"
                type="RequestDesk\Blog\Model\PostRepository"/>

    <preference for="RequestDesk\Blog\Api\PostManagementInterface"
                type="RequestDesk\Blog\Model\PostManagement"/>

    <preference for="RequestDesk\Blog\Api\DataExportInterface"
                type="RequestDesk\Blog\Model\DataExport"/>

    <preference for="RequestDesk\Blog\Api\ExternalBlogInterface"
                type="RequestDesk\Blog\Model\ExternalBlog"/>

    <!--
        Optional Q&A integration seam.

        These bind to adapters, not to the no-op defaults, because RequestDesk_Blog
        is sequenced AFTER RequestDesk_Qa: this file always loads last, so a
        preference declared by the Q&A module could never win, and Qa cannot
        sequence Blog back without a circular dependency. The adapters resolve the
        real Q&A services at runtime and degrade to no-ops when Q&A is absent, so
        the blog still runs standalone.
    -->
    <preference for="RequestDesk\Blog\Api\QaLinkResolverInterface"
                type="RequestDesk\Blog\Model\Qa\QaLinkResolverAdapter"/>

    <preference for="RequestDesk\Blog\Api\FaqSchemaBuilderInterface"
                type="RequestDesk\Blog\Model\Qa\FaqSchemaBuilderAdapter"/>

    <preference for="RequestDesk\Blog\Api\QaPairOptionsInterface"
                type="RequestDesk\Blog\Model\Qa\QaPairOptionsAdapter"/>

    <!--
        Every admin grid data source registers here, in ONE type node.

        This must stay a single node. The mapper that turns this file into DI
        config walks the children and assigns by type name, so a second
        <type name="...CollectionFactory"> does not merge with the first, it
        replaces it. This file used to carry four of them (post, comment, tag,
        author); only the last one survived, and the other three grids died with
        "Not registered handle <name>" the moment they were opened. The XSD
        catches it too - uniqueType - which is why the file failed validation.

        Add a grid by adding an <item> below, never a second <type> node.
    -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="requestdesk_blog_post_listing_data_source" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Post\Grid\Collection</item>
                <item name="requestdesk_blog_comment_listing_data_source" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Comment\Grid\Collection</item>
                <item name="requestdesk_blog_tag_listing_data_source" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Tag\Grid\Collection</item>
                <item name="requestdesk_blog_author_listing_data_source" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Author\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!-- Grid Collection Virtual Type -->
    <virtualType name="RequestDesk\Blog\Model\ResourceModel\Post\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">requestdesk_blog_post</argument>
            <argument name="resourceModel" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Post</argument>
        </arguments>
    </virtualType>

    <!-- Author avatar uploads. Files land in media/requestdesk/blog/author, via a
         tmp folder that Magento sweeps if the form is never saved. -->
    <type name="RequestDesk\Blog\Model\AuthorImageUploader">
        <arguments>
            <argument name="baseTmpPath" xsi:type="string">requestdesk/blog/author/tmp</argument>
            <argument name="basePath" xsi:type="string">requestdesk/blog/author</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="png" xsi:type="string">png</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="webp" xsi:type="string">webp</item>
            </argument>
            <argument name="allowedMimeTypes" xsi:type="array">
                <item name="jpg" xsi:type="string">image/jpg</item>
                <item name="jpeg" xsi:type="string">image/jpeg</item>
                <item name="png" xsi:type="string">image/png</item>
                <item name="gif" xsi:type="string">image/gif</item>
                <item name="webp" xsi:type="string">image/webp</item>
            </argument>
        </arguments>
    </type>

    <type name="RequestDesk\Blog\Controller\Adminhtml\Author\Upload">
        <arguments>
            <argument name="imageUploader" xsi:type="object">RequestDesk\Blog\Model\AuthorImageUploader</argument>
        </arguments>
    </type>

    <type name="RequestDesk\Blog\Controller\Adminhtml\Author\Save">
        <arguments>
            <argument name="imageUploader" xsi:type="object">RequestDesk\Blog\Model\AuthorImageUploader</argument>
        </arguments>
    </type>

    <!-- Product Export Service -->
    <type name="RequestDesk\Blog\Service\ProductExportService">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <!-- Post Import Service -->
    <type name="RequestDesk\Blog\Service\PostImportService">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </type>

    <!-- Comment Grid Collection (registered in the CollectionFactory node above) -->
    <virtualType name="RequestDesk\Blog\Model\ResourceModel\Comment\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">requestdesk_blog_comment</argument>
            <argument name="resourceModel" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Comment</argument>
        </arguments>
    </virtualType>

    <!-- Tag Grid Collection (registered in the CollectionFactory node above) -->
    <virtualType name="RequestDesk\Blog\Model\ResourceModel\Tag\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">requestdesk_blog_tag</argument>
            <argument name="resourceModel" xsi:type="string">RequestDesk\Blog\Model\ResourceModel\Tag</argument>
        </arguments>
    </virtualType>

    <!--
        The author grid has no virtualType: RequestDesk\Blog\Model\ResourceModel\Author\Grid\Collection
        is a concrete class, because it adds the admin_user join.
    -->

    <!-- Clean up polymorphic Q&A links when a post is deleted -->
    <type name="RequestDesk\Blog\Api\PostRepositoryInterface">
        <plugin name="requestdesk_blog_post_qa_cleanup" type="RequestDesk\Blog\Plugin\PostRepositoryQaCleanup"/>
    </type>

    <!-- Console commands -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="requestdesk_blog_migrate_amasty" xsi:type="object">RequestDesk\Blog\Console\Command\MigrateAmastyCommand</item>
                <item name="requestdesk_blog_repair_schema" xsi:type="object">RequestDesk\Blog\Console\Command\RepairSchemaCommand</item>
                <item name="requestdesk_blog_repair_content" xsi:type="object">RequestDesk\Blog\Console\Command\RepairContentCommand</item>
            </argument>
        </arguments>
    </type>

</config>

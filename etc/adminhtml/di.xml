<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Adminhtml DI
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Keep Magento's category-image plugin off the author avatar uploader.

        Magento_MediaGalleryCatalogIntegration declares `save_category_image` on the
        concrete Magento\Catalog\Model\ImageUploader. It pushes every upload into the
        media gallery and its afterMoveFileFromTmp never consults
        IsPathExcludedInterface, so it fires on author avatars and throws - which,
        before the move was isolated in Author/Save.php, discarded the whole author.

        This MUST target the real subclass, not a virtualType. A virtualType has no
        interceptor of its own; the instance is a ...\ImageUploader\Interceptor whose
        subjectType is the concrete parent, so plugin lookup ignores the virtualType's
        config entirely. Disabling it on a virtualType looks correct - getNext() even
        reports no plugins - while the plugin carries on running. See the note in
        Model/AuthorImageUploader.php.

        Scoped to this class only: category images keep the plugin and keep appearing
        in the media gallery.
    -->
    <type name="RequestDesk\Blog\Model\AuthorImageUploader">
        <plugin name="save_category_image" disabled="true"/>
    </type>
</config>

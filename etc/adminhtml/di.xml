<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Adminhtml DI
 *
 * @category  RequestDesk
 * @package   RequestDesk_Blog
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Keep Magento's category-image plugin off the author avatar uploader.

        Magento_MediaGalleryCatalogIntegration declares `save_category_image` on the
        concrete Magento\Catalog\Model\ImageUploader. Plugins on a type also run for
        every virtualType of that type, so a plugin written for catalog CATEGORY
        images was firing on author avatars too. It pushes the file into the media
        gallery, which throws for this path, and that exception surfaced on every
        single avatar save - before the move was isolated in Author/Save.php it took
        the whole author record down with it.

        Disabling it here is scoped to this virtualType only: category images keep
        the plugin and keep appearing in the media gallery. Author avatars are
        managed from the author form and were never meant to be gallery assets.
    -->
    <virtualType name="RequestDeskBlogAuthorImageUploader" type="Magento\Catalog\Model\ImageUploader">
        <plugin name="save_category_image" disabled="true"/>
    </virtualType>
</config>

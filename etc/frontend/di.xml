<?xml version="1.0"?>
<!--
/**
 * RequestDesk Blog - Frontend Dependency Injection (Hyva Compatibility)
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Register with Hyva Compat Module Fallback -->
    <type name="Hyva\CompatModuleFallback\Model\CompatModuleRegistry">
        <arguments>
            <argument name="compatModules" xsi:type="array">
                <item name="requestdesk-blog-hyva-compatibility" xsi:type="array">
                    <item name="original_module" xsi:type="string">RequestDesk_Blog</item>
                    <item name="compat_module" xsi:type="string">RequestDesk_Blog</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!--
        Pretty post URLs: /blog/<url-key> as well as /blog/post/view/id/N.

        Runs after Magento's standard router, so a real controller path always
        wins and this only ever picks up what would otherwise 404. The id form
        keeps working, so no rewrites and no redirects.

        sortOrder 50 rather than 60 on purpose: Amasty_Blog registers its own
        router at 60 for the same /blog prefix, and on a tie it is reached first,
        which sent every pretty post URL to the legacy Amasty page instead of
        this module's. 50 also runs before the CMS router, which is safe here
        because match() returns null unless the path is exactly /blog/<key> and
        a published post owns that key.
    -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="requestdesk_blog" xsi:type="array">
                    <item name="class" xsi:type="string">RequestDesk\Blog\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">50</item>
                </item>
            </argument>
        </arguments>
    </type>

</config>
